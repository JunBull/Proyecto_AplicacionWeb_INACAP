APP_NAME="Pañol INACAP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==========================================
# CONFIGURACIÓN DE BASE DE DATOS (DOCKER)
# ==========================================
# DB_HOST apunta al servicio 'db' definido en docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=panol_inacap
DB_USERNAME=postgres
DB_PASSWORD=secret
# Si el puerto 5432 ya está ocupado en tu máquina física, cambia FORWARD_DB_PORT a 5433
FORWARD_DB_PORT=5432

# ==========================================
# SESIONES, CACHE Y COLAS ASÍNCRONAS
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================
# SERVIDOR DE CORREO DE PRUEBAS (MAILPIT)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="panol.temuco@inacap.cl"
MAIL_FROM_NAME="${APP_NAME}"

# Puertos expuestos para Mailpit en el host
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

VITE_APP_NAME="${APP_NAME}"
